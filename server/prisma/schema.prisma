// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Mode {
  MOVIE
  FOOD
  PERSONALIZED
}

model RoomMember {
  id       String @id @default(cuid())
  username String

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  swipes Swipe[]
}

model Item {
  id          String @id @default(cuid())
  title       String
  description String

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  swipes  Swipe[]
  matches Match[]
}

model Swipe {
  id    String  @id @default(cuid())
  liked Boolean

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  memberId String
  member   RoomMember @relation(fields: [memberId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([roomId, memberId, itemId])
}

model Match {
  id String @id @default(cuid())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([roomId, itemId])
}

model Room {
  id        String   @id @default(cuid())
  code      String   @unique
  mode      Mode
  genre     String?
  createdAt DateTime @default(now())

  members RoomMember[]
  items   Item[]
  swipes  Swipe[]
  matches Match[]
}
